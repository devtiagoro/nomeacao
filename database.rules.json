{
  "rules": {
    ".read": false,
    ".write": false,

    "current": {
      ".read": true,
      ".write": "newData.exists() && newData.isString() && newData.parent().child('meetings').child(newData.val()).exists()",
      ".validate": "newData.isString() && newData.parent().child('meetings').child(newData.val()).exists()"
    },

    "meetings": {
      ".read": true,
      "$mid": {
        ".write": "!data.exists() && $mid.matches(/^m_[A-Za-z0-9_-]{12}$/) && newData.hasChildren(['id', 'name', 'expectedParticipants', 'createdAt']) && newData.child('id').val() === $mid",
        ".validate": "$mid.matches(/^m_[A-Za-z0-9_-]{12}$/) && newData.hasChildren(['id', 'name', 'expectedParticipants', 'createdAt'])",
        "id": { ".validate": "newData.val() === $mid" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120 && (!data.exists() || newData.val() === data.val())" },
        "expectedParticipants": {
          ".write": "data.exists() && newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000 && newData.val() % 1 === 0",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000 && newData.val() % 1 === 0"
        },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "currentOfficeId": {
          ".write": "newData.exists() && newData.isString() && newData.parent().child('offices').child(newData.val()).exists()",
          ".validate": "newData.isString() && newData.parent().child('offices').child(newData.val()).exists()"
        },
        "offices": {
          "$oid": {
            ".write": "newData.exists() && $oid.matches(/^o_[A-Za-z0-9_-]{12}$/) && newData.hasChildren(['id', 'title', 'voteType', 'maxChoices', 'status', 'liveResults', 'createdAt']) && newData.child('id').val() === $oid && (!data.exists() || data.child('status').val() !== 'closed')",
            ".validate": "$oid.matches(/^o_[A-Za-z0-9_-]{12}$/) && newData.hasChildren(['id', 'title', 'voteType', 'maxChoices', 'status', 'liveResults', 'createdAt'])",
            "id": { ".validate": "newData.val() === $oid" },
            "title": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120 && (!data.exists() || newData.val() === data.val() || data.parent().child('status').val() === 'draft' || data.parent().child('status').val() === 'discussing')"
            },
            "voteType": {
              ".validate": "(newData.val() === 'single' || newData.val() === 'multiple') && (!data.exists() || newData.val() === data.val() || data.parent().child('status').val() === 'draft' || data.parent().child('status').val() === 'discussing')"
            },
            "maxChoices": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100 && (newData.parent().child('voteType').val() === 'multiple' || newData.val() === 1) && (!data.exists() || newData.val() === data.val() || data.parent().child('status').val() === 'draft' || data.parent().child('status').val() === 'discussing')"
            },
            "status": {
              ".validate": "(newData.val() === 'draft' || newData.val() === 'discussing' || newData.val() === 'voting_open' || newData.val() === 'closed') && (!data.exists() || newData.val() === data.val() || (data.val() === 'draft' && newData.val() === 'discussing') || (data.val() === 'discussing' && newData.val() === 'voting_open') || (data.val() === 'voting_open' && newData.val() === 'closed'))"
            },
            "liveResults": { ".validate": "newData.isBoolean()" },
            "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "presentedAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "openedAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "closedAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "candidates": {
              "$cid": {
                ".validate": "$cid.matches(/^c_[A-Za-z0-9_-]{12}$/) && newData.hasChildren(['id', 'name', 'order']) && (!data.parent().parent().exists() || data.parent().parent().child('status').val() === 'draft' || data.parent().parent().child('status').val() === 'discussing' || (data.exists() && newData.child('name').val() === data.child('name').val() && newData.child('order').val() === data.child('order').val()))",
                "id": { ".validate": "newData.val() === $cid" },
                "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
                "order": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "counts": {
      ".read": true,
      "$mid": {
        "$oid": {
          ".write": "newData.exists() && root.child('meetings').child($mid).child('currentOfficeId').val() === $oid && root.child('meetings').child($mid).child('offices').child($oid).child('status').val() === 'voting_open'",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },

    "tallies": {
      "$mid": {
        ".read": "root.child('meetings').child($mid).exists()",
        "$oid": {
          "$choice": {
            ".write": "newData.exists() && root.child('meetings').child($mid).child('currentOfficeId').val() === $oid && root.child('meetings').child($mid).child('offices').child($oid).child('status').val() === 'voting_open' && ($choice === 'abstain' || root.child('meetings').child($mid).child('offices').child($oid).child('candidates').child($choice).exists())",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          }
        }
      }
    },

    "receipts": {
      "$mid": {
        "$oid": {
          "$rid": {
            ".write": "!data.exists() && $rid.matches(/^[A-Za-z0-9_-]{16,64}$/) && root.child('meetings').child($mid).child('currentOfficeId').val() === $oid && root.child('meetings').child($mid).child('offices').child($oid).child('status').val() === 'voting_open'",
            ".validate": "newData.val() === now"
          }
        }
      }
    }
  }
}
