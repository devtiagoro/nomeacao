{
  "name": "nomeia",
  "version": "2.0.0",
  "private": true,
  "description": "NOMEIA — nomeações e votações em reuniões presenciais. App estático (PWA) + Firebase Realtime Database.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "emulators": "firebase emulators:start --only database,auth --project demo-nomeia",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "test:rules": "firebase emulators:exec --only database --project demo-nomeia \"node --test --test-reporter=spec test/rules/database.rules.test.js\"",
    "deploy:rules": "firebase deploy --only database",
    "icons": "node scripts/gen-icons.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.34.2"
  }
}
