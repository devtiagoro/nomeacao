# Copie para .env e ajuste. Nunca versione o .env.

# Porta e interface. 0.0.0.0 permite acesso de celulares na mesma rede.
PORT=3000
HOST=0.0.0.0

# Segredo administrativo (OBRIGATÓRIO em produção, mínimo 16 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Se ficar vazio em desenvolvimento, o servidor gera um e grava em data/admin-secret.txt.
ADMIN_SECRET=

# development | production (production exige ADMIN_SECRET e usa cookie Secure + HSTS)
NODE_ENV=development

# Diretório persistente dos arquivos JSON (fora de public/).
DATA_DIR=./data

# URL pública usada nos QR Codes e links (ex.: https://nomeia.suaorg.org.br).
# Se vazia, usa o Host da requisição; "localhost" é trocado pelo IP da rede local.
PUBLIC_ORIGIN=

# Origens adicionais aceitas (separadas por vírgula). Normalmente vazio.
ALLOWED_ORIGINS=

# 1 quando estiver atrás de proxy reverso (nginx/Caddy) que define X-Forwarded-For/Proto/Host.
TRUST_PROXY=0

# HTTPS direto no Node (opcional, útil na rede local com mkcert). Caminhos para PEM.
TLS_KEY_FILE=
TLS_CERT_FILE=

# Quantidade de backups versionados mantidos por reunião (os mais novos são preservados).
BACKUP_KEEP=100
